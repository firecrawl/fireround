    "vercel-build": "node scripts/migrate.ts && next build",
    "merge-duplicates": "node --env-file-if-exists=.env scripts/maintenance/merge-duplicates.ts",
    "merge-duplicate-rounds": "node --env-file-if-exists=.env scripts/maintenance/merge-duplicate-rounds.ts",
    "retitle-sources": "node --env-file-if-exists=.env scripts/maintenance/retitle-sources.ts",
