    "@modelcontextprotocol/server": "^2.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.143",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "1.0.0-rc.4",
    "feed": "^6.0.0",
    "firecrawl": "^4.48.0",
    "geist": "^1.8.1",
    "lucide-react": "^1.59.0",
    "mcp-handler": "^2.3.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "posthog-js": "^1.438.12",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.8.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.5.0",
  "description": "The open-source funding feed built on Firecrawl: funding announcements from across the open web, pre-seed to growth, as structured, deduped, verified records with a dashboard, feeds, an API, and an MCP server.",
