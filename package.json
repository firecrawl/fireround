{
  "name": "fireround",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sweep": "node --env-file-if-exists=.env scripts/sweep.ts",
    "backfill": "node --env-file-if-exists=.env scripts/backfill.ts",
    "typecheck": "next typegen && tsc --noEmit && tsc -p packages/core/tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @fireround/core exec drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "backup-db": "node --env-file-if-exists=.env scripts/backup-db.ts",
    "feed-token": "node --env-file-if-exists=.env scripts/feed-token.ts",
